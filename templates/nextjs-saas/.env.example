# Database
# ローカル開発: docker/docker-compose.yml の PostgreSQL を使用
DATABASE_URL="postgresql://dev:devpassword@localhost:5432/devdb"

# Better Auth
BETTER_AUTH_SECRET=""          # openssl rand -base64 32 で生成
BETTER_AUTH_URL="http://localhost:3000"

# Email (Resend - 無料: 3,000通/月)
# https://resend.com でアカウント作成
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="{{PROJECT_NAME}}"
